{
  "policy_id": "datafog-mvp",
  "policy_version": "v2026-02-23-1",
  "description": "Demo policy for observable CLI-gated command.exec control",
  "updated_at": "2026-02-23T00:00:00Z",
  "rules": [
    {
      "id": "allow-codex-help",
      "description": "Allow codex help command",
      "priority": 100,
      "effect": "allow",
      "match": {
        "action_types": ["command.exec"],
        "tools": ["codex"],
        "commands": ["--help"]
      }
    },
    {
      "id": "allow-claude-help",
      "description": "Allow claude help command",
      "priority": 100,
      "effect": "allow",
      "match": {
        "action_types": ["command.exec"],
        "tools": ["claude"],
        "commands": ["--help"]
      }
    },
    {
      "id": "transform-fs-file-write-email",
      "description": "Apply email masking transform for file writes",
      "priority": 80,
      "effect": "allow_with_redaction",
      "match": {
        "action_types": ["file.write"],
        "tools": ["fs"]
      },
      "entity_requirements": ["email"],
      "entity_transforms": [
        {
          "entity_type": "email",
          "mode": "mask"
        }
      ]
    },
    {
      "id": "deny-shell-like-tooling",
      "description": "Block shell-style invocation paths from agent actions",
      "priority": 90,
      "effect": "deny",
      "match": {
        "action_types": ["command.exec"],
        "tools": ["codex", "claude"],
        "commands": ["-lc"]
      },
      "entity_requirements": []
    }
  ]
}
